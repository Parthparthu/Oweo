rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getGroup(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId));
    }

    function isGroupMember(groupId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/groups/$(groupId)) &&
        request.auth.uid in getGroup(groupId).data.memberIds;
    }

    function isGroupCreator(groupId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/groups/$(groupId)) &&
        getGroup(groupId).data.createdBy == request.auth.uid;
    }

    // 1. Users collection (strictly private to owner)
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // 2. Personal Expenses collection (strictly private to owner)
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.amountPaise is int &&
        request.resource.data.amountPaise > 0;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 3. Direct 1:1 Debts collection (strictly between the 2 participants)
    match /directDebts/{debtId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.creatorId == request.auth.uid ||
        (resource.data.otherUserId != null && resource.data.otherUserId == request.auth.uid)
      );
      allow create: if isAuthenticated() &&
        request.resource.data.creatorId == request.auth.uid &&
        request.resource.data.amountPaise is int &&
        request.resource.data.amountPaise > 0;
      allow update: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid ||
        (resource.data.otherUserId != null && resource.data.otherUserId == request.auth.uid)
      );
      allow delete: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
    }

    // 4. Groups collection (restricted to authenticated members & creators)
    match /groups/{groupId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid in resource.data.memberIds ||
        resource.data.createdBy == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.auth.uid in request.resource.data.memberIds;
      allow update: if isAuthenticated() && (
        // Existing member updating group details
        request.auth.uid in resource.data.memberIds ||
        // User joining group via valid invite / redemption
        request.auth.uid in request.resource.data.memberIds
      );
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;

      // Group Members subcollection
      match /members/{memberId} {
        allow read: if isAuthenticated() && (
          memberId == request.auth.uid ||
          isGroupMember(groupId)
        );
        allow create: if isAuthenticated() && (
          // Creator creating their own owner record
          (memberId == request.auth.uid && isGroupCreator(groupId)) ||
          // Existing member adding another member with non-owner role
          (isGroupMember(groupId) && request.resource.data.role != 'owner') ||
          // Joining member adding self with member role
          (memberId == request.auth.uid && request.resource.data.role == 'member')
        );
        allow update: if isAuthenticated() && isGroupMember(groupId) && (
          // Role cannot be escalated to owner by regular members
          request.resource.data.role == resource.data.role || isGroupCreator(groupId)
        );
        allow delete: if isAuthenticated() && isGroupMember(groupId) && (
          // Group owner cannot be deleted unless by self on group deletion
          resource.data.role != 'owner' || request.auth.uid == memberId
        );
      }

      // Group Expenses subcollection
      match /expenses/{expenseId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) &&
          request.resource.data.amountPaise is int &&
          request.resource.data.amountPaise > 0;
        allow update, delete: if isGroupMember(groupId);
      }

      // Group Settlements subcollection
      match /settlements/{settlementId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) &&
          request.resource.data.amountPaise is int &&
          request.resource.data.amountPaise > 0;
        allow update, delete: if isGroupMember(groupId);
      }

      // Append-Only Group Audit Logs (Immutable)
      match /auditLogs/{logId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) &&
          request.resource.data.actorId == request.auth.uid;
        allow update, delete: if false; // Append-only, never modifiable or deletable
      }
    }

    // 5. Invites collection (tamper-proof invite redemption)
    match /invites/{inviteCode} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.createdBy == request.auth.uid &&
        isGroupMember(request.resource.data.groupId);
      allow update: if isAuthenticated() && (
        // Creator updating or revoking invite
        resource.data.createdBy == request.auth.uid ||
        // Joining user incrementing usedCount only (if not revoked and not expired)
        (
          !resource.data.isRevoked &&
          resource.data.expiresAt > request.time.toMillis() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']) &&
          request.resource.data.usedCount == resource.data.usedCount + 1
        )
      );
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // 6. Recurring Expenses / Subscriptions (strictly private to owner)
    match /recurringExpenses/{recurringId} {
      allow read: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.amountPaise is int &&
        request.resource.data.amountPaise > 0;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
